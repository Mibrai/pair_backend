# Pair Application - Frontend Environment Variables
# Copy this file to .env and configure your values

# API Configuration
REACT_APP_API_BASE_URL=http://localhost:8090/api
REACT_APP_WS_BASE_URL=ws://localhost:8090/ws

# For local network access (replace with your IP)
# REACT_APP_API_BASE_URL=http://192.168.2.47:8090/api
# REACT_APP_WS_BASE_URL=ws://192.168.2.47:8090/ws

# Application
REACT_APP_NAME=Pair
REACT_APP_VERSION=1.0.0
REACT_APP_ENV=development

# Map Configuration (Optional - defaults to Paris)
REACT_APP_MAP_DEFAULT_LAT=48.8566
REACT_APP_MAP_DEFAULT_LNG=2.3522
REACT_APP_MAP_DEFAULT_ZOOM=12

# Google Maps API Key (if using Google Maps)
# REACT_APP_GOOGLE_MAPS_API_KEY=your_api_key_here

# Mapbox API Key (if using Mapbox)
# REACT_APP_MAPBOX_TOKEN=your_mapbox_token_here

# Feature Flags
REACT_APP_ENABLE_CHAT=true
REACT_APP_ENABLE_MAP=true
REACT_APP_ENABLE_SEARCH=true
REACT_APP_ENABLE_PROGRESSIONS=true

# Debug
REACT_APP_DEBUG=false
REACT_APP_LOG_LEVEL=info
