        <!-- Pin explicite : tika-core 2.9.1 tirait commons-io 2.14.0, trop ancien
             pour l'API utilisée par testcontainers 2.x (FileTimes.toUnixTime,
             ajouté en 2.17.0), ce qui casse la construction d'image Docker. -->
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.19.0</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- Une seule JVM pour toute la suite.

                 Elle en forkait une PAR CLASSE. La raison d'origine tenait : les
                 tests @SpringBootTest partagent sinon des ressources par JVM —
                 compteurs en mémoire du RateLimiter, pool Reactor Netty global —
                 entre classes indépendantes, ce qui provoquait des échecs
                 aléatoires quand la suite tournait en entier.

                 Elle a cessé de tenir entièrement : AbstractIntegrationTest a
                 depuis gagné un @BeforeEach resetRateLimiter(), qui traite la
                 première moitié du problème à la source. Et le port du connecteur
                 HTTP additionnel est passé à 0 dans application-test.properties,
                 ce qui traite la seconde.

                 Ce que le fork par classe coûtait, mesuré le 07/09 : sur les
                 19,05 s d'une classe d'intégration, la JVM et le scan du
                 classpath en prennent environ 8,5, et le contexte Spring 8,87 —
                 ce dernier étant reconstruit à chaque fois puisque le cache de
                 contexte meurt avec la JVM. Le conteneur Postgres, lui, ne pèse
                 que 1,70 s : ce n'était pas là qu'était le problème.

                 Avec reuseForks=true et le conteneur singleton
                 d'AbstractIntegrationTest, la JVM démarre une fois et Spring
                 réutilise ses contextes. En contrepartie, les classes ne sont
                 plus isolées ni en mémoire ni en base : un test qui dépend de
                 l'ordre le fait désormais savoir. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <reuseForks>true</reuseForks>
                    <forkCount>1</forkCount>
                    <!-- Remède à « Unable to find a @SpringBootConfiguration by
                         searching packages upwards » : avec reuseForks=true, la
                         recherche de configuration de Spring s'exécute sur un autre
                         fil (FutureTask dans la trace) et ne voit plus target/classes
                         à travers le chargeur système de Surefire. Constaté le 08/09
                         sur ActivitySearchAccentIntegrationTest et
                         NextSessionAtIntegrationTest, vertes en isolation, rouges
                         derrière onze autres classes dans la même JVM.
                         useManifestOnlyJar=false répare pareil, au même coût. -->
                    <useSystemClassLoader>false</useSystemClassLoader>
                    <!-- Une JVM unique garde tout en mémoire, et le cache de contexte
                         de Spring en conserve 32 par défaut : autant d'applications
                         complètes vivantes en même temps. Le 08/09, la suite se
                         faisait tuer faute de mémoire à la 47e classe, deux fois au
                         même endroit. Quatre contextes suffisent — le but du
                         conteneur singleton est justement qu'ils soient presque tous
                         identiques donc réutilisés. -->
                    <!-- 12/09 : le cache passe de 3 à 4, le tas reste à 3 Go.
                         Le commentaire ci-dessus disait déjà « quatre contextes
                         suffisent » quand la valeur en disait trois : c'est la valeur
                         qui avait tort. La suite a gagné une quatrième configuration
                         distincte (WatchLoopPartialFailureIntegrationTest et son
                         @MockitoSpyBean, seul moyen de faire échouer une veille — la
                         voie « par les données » a été cherchée puis démontrée fermée,
                         voir sa javadoc), et à maxSize=3 cette quatrième évinçait les
                         trois autres, aussitôt reconstruites.

                         Deux corrections à ce que ce commentaire a d'abord affirmé,
                         parce qu'une justification fausse coûte plus cher qu'aucune :
                         les quatorze « Timeout on blocking read for 30 s » de
                         PublicProgramPageIntegrationTest n'étaient PAS l'effet de
                         cette éviction. Ils venaient d'un blocage définitif de fil
                         HTTP — l'indexation soumise pendant le commit, en
                         REQUIRES_NEW, réclamant le verrou de sa propre transaction
                         (voir domain/indexation/ApresCommit). Et le tas de 4 Go que
                         cette lecture erronée avait fait poser ne tient pas sur une
                         machine de 16 Go où tournent Docker, un simulateur iOS et
                         l'IDE : la JVM s'y fait tuer au démarrage, faute de mémoire.
                         3 Go restent la valeur juste, et elle est éprouvée.

                         Ne pas redescendre le cache à 3 sans retirer d'abord une
                         configuration : plusieurs classes portent un @MockitoBean
                         NotificationService et forment déjà la leur. -->
                    <!-- @{argLine} en tête (P-BA-20) : c'est la propriété où
                         jacoco:prepare-agent pose son agent. Une argLine littérale
                         l'écrasait, et JaCoCo n'a donc jamais rien mesuré — le
                         rapport était « sauté faute de données » à chaque verify.
                         La propriété vide des <properties> sert quand l'agent ne
                         s'exécute pas. -->
                    <argLine>@{argLine} -Xmx3g -Dspring.test.context.cache.maxSize=4</argLine>
                    <!-- Charge un vrai modèle ONNX (~120 Mo, téléchargement réseau) :
                         exclu par défaut, exécuter avec -DexcludedGroups= . -->
                    <excludedGroups>${excludedGroups}</excludedGroups>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <!--
                      Grave dans le jar de quoi savoir QUEL build tourne.

                      Sans cela, /actuator/info rendait un objet vide, et une
                      divergence entre la spec et la production ne pouvait pas être
                      instruite : impossible de dire si le serveur exécute le code
                      qu'on est en train de lire. C'est exactement ce qui a bloqué
                      l'instruction du relevé du 01/09 sur /slots/{id}/participants.

                      Le sha est pris dans l'environnement plutôt que d'un plugin
                      git : la plateforme de déploiement le pose déjà, et lire le
                      dépôt à la construction ne dirait rien dans un conteneur qui
                      n'en a pas.
                    -->
                    <execution>
                        <id>build-info</id>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                        <configuration>
                            <additionalProperties>
                                <commit>${build.commit}</commit>
                            </additionalProperties>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- JaCoCo Maven Plugin for Code Coverage -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.11</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!-- P-BA-20 — un plancher de couverture par paquet, sur les trois
                         domaines où une régression met quelqu'un en danger ou enfreint
                         le RGPD : la veille, l'outbox des alertes, la purge et l'export.
                         Relevé le 13/09/2026 sur la suite entière (1688 tests), fixé au
                         mesuré moins deux points, à remonter par paliers :
                         watch 85,3 %, watch.jobs 93,5 %, outbox 78,1 %, gdpr 27,0 %,
                         gdpr.jobs 61,9 %. Le plancher de gdpr est bas parce que
                         l'export (P-BL-13) n'est pas encore testé. Bloque verify, donc la CI. -->
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                            <rule>
                                <element>PACKAGE</element>
                                <includes><include>org.program.pair.domain.watch</include></includes>
                                <limits>
                                    <limit>
                                        <counter>LINE</counter>
                                        <value>COVEREDRATIO</value>
                                        <minimum>0.83</minimum>
                                    </limit>
                                </limits>
                            </rule>
