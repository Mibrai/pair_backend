<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>org.program</groupId>
    <artifactId>Pair</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>Pair</name>
    <description>Pair</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>17</java.version>
        <!-- Surchargeable en ligne de commande : mvn test -DexcludedGroups= -->
        <excludedGroups>model-integration</excludedGroups>

        <!--
          Identité du build, gravée dans build-info.properties et rendue par
          /actuator/info. Valeur de repli pour une construction locale ; la
          plateforme de déploiement la remplace par le profil ci-dessous. Une seule
          propriété, et pas la branche : le profil s'active sur la présence du sha,
          et une variable de branche absente ferait échouer la construction sur un
          renseignement qui n'apprend rien de plus.
        -->
        <build.commit>local</build.commit>
    </properties>

    <profiles>
        <!--
          Sur la plateforme de déploiement, le sha et la branche viennent de
          l'environnement. Le profil ne s'active que si la variable existe : une
          construction locale garde ses valeurs de repli plutôt que d'échouer.
        -->
        <profile>
            <id>build-identity-from-env</id>
            <activation>
                <property>
                    <name>env.RAILWAY_GIT_COMMIT_SHA</name>
                </property>
            </activation>
            <properties>
                <build.commit>${env.RAILWAY_GIT_COMMIT_SHA}</build.commit>
            </properties>
        </profile>
    </profiles>
    <dependencies>
        <!--
            Moteur de récurrence RFC 5545. Écrit à la main, il couvrirait FREQ et
            INTERVAL puis buterait sur BYDAY multi-jours, UNTIL et COUNT —
            exactement le moteur partiel que le client a déjà côté Flutter et
            qu'il nous demande de remplacer. Autant prendre une implémentation
            complète : la règle et le calendrier sont ici.
        -->
        <dependency>
            <groupId>org.mnode.ical4j</groupId>
            <artifactId>ical4j</artifactId>
            <version>4.0.4</version>
        </dependency>

        <!-- Spring Boot Starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <!--
          Rendu des pages publiques (partage de créneau, page de sécurité). Les 179
          endpoints existants sont en JSON et le resteront : Thymeleaf ne sert qu'aux
          rares pages destinées à un navigateur ou à un robot d'aperçu.

          Il est là pour une raison précise. Une page de partage doit porter ses
          métadonnées OpenGraph dans des attributs — og:title vaut le titre du
          programme, saisi par un utilisateur. Composer ces attributs à la main dans
          un text block demanderait de les échapper soi-même, et HtmlSanitizer
          assainit du contenu, pas des valeurs d'attribut : un titre contenant une
          apostrophe ou un guillemet casserait la balise. th:content échappe pour
          nous, systématiquement.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-messaging</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Database -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- PostGIS / Hibernate Spatial -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-spatial</artifactId>
        </dependency>

        <!-- pgvector -->
        <dependency>
            <groupId>com.pgvector</groupId>
            <artifactId>pgvector</artifactId>
            <version>0.1.6</version>
        </dependency>

        <!-- Flyway -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>

        <!-- JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.3</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.3</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.3</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Email -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- Phase 2: WebFlux for LLM API calls and Resend email -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- Local trilingual embedding model (ONNX via DJL) -->
        <dependency>
            <groupId>ai.djl</groupId>
            <artifactId>api</artifactId>
            <version>0.31.1</version>
        </dependency>
        <dependency>
            <groupId>ai.djl.onnxruntime</groupId>
            <artifactId>onnxruntime-engine</artifactId>
            <version>0.31.1</version>
        </dependency>
        <dependency>
            <groupId>ai.djl.huggingface</groupId>
            <artifactId>tokenizers</artifactId>
            <version>0.31.1</version>
        </dependency>

        <!-- Jackson Databind (should be included but explicit) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Phase 2: OWASP HTML Sanitizer -->
        <dependency>
            <groupId>com.googlecode.owasp-java-html-sanitizer</groupId>
            <artifactId>owasp-java-html-sanitizer</artifactId>
            <version>20220608.1</version>
        </dependency>

        <!-- Phase 2: Apache Tika for MIME validation -->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
            <version>2.9.1</version>
        </dependency>

        <!-- Phase 2: Thumbnailator for image re-encoding -->
        <dependency>
            <groupId>net.coobird</groupId>
            <artifactId>thumbnailator</artifactId>
            <version>0.4.20</version>
        </dependency>

        <!-- MVP: Swagger/OpenAPI Documentation -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.7.0</version>
        </dependency>

        <!-- Phase 4: Redis (Désactivé par défaut - Décommenter pour activer) -->
        <!--
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        -->

        <!-- Phase 4: Firebase Admin SDK (Push Notifications) -->
        <dependency>
            <groupId>com.google.firebase</groupId>
            <artifactId>firebase-admin</artifactId>
            <version>9.2.0</version>
        </dependency>

        <!-- Phase 4: Quartz (Scheduled Jobs) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-quartz</artifactId>
        </dependency>

        <!-- Phase 4: Spring Actuator (Monitoring) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Dev Tools -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- Test Dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers (version gérée par la BOM de spring-boot-starter-parent) -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Pin explicite : tika-core (2.9.1) tire commons-io 2.14.0, trop ancien
             pour l'API utilisée par testcontainers 2.x (FileTimes.toUnixTime,
             ajouté en 2.17.0), ce qui casse la construction d'image Docker. -->
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.19.0</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- Un fork JVM par classe de test : les tests @SpringBootTest partagent
                 sinon des ressources par JVM (les compteurs en mémoire du
                 RateLimiter, le pool Reactor Netty global) entre classes
                 indépendantes, provoquant des échecs aléatoires (plafond atteint,
                 timeouts réseau) quand la suite tourne en entier plutôt que classe
                 par classe. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <reuseForks>false</reuseForks>
                    <forkCount>1</forkCount>
                    <!-- Charge un vrai modèle ONNX (~120 Mo, téléchargement réseau) :
                         exclu par défaut, exécuter avec -DexcludedGroups= . -->
                    <excludedGroups>${excludedGroups}</excludedGroups>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <!--
                      Grave dans le jar de quoi savoir QUEL build tourne.

                      Sans cela, /actuator/info rendait un objet vide, et une
                      divergence entre la spec et la production ne pouvait pas être
                      instruite : impossible de dire si le serveur exécute le code
                      qu'on est en train de lire. C'est exactement ce qui a bloqué
                      l'instruction du relevé du 01/09 sur /slots/{id}/participants.

                      Le sha est pris dans l'environnement plutôt que d'un plugin
                      git : la plateforme de déploiement le pose déjà, et lire le
                      dépôt à la construction ne dirait rien dans un conteneur qui
                      n'en a pas.
                    -->
                    <execution>
                        <id>build-info</id>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                        <configuration>
                            <additionalProperties>
                                <commit>${build.commit}</commit>
                            </additionalProperties>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- JaCoCo Maven Plugin for Code Coverage -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.11</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
