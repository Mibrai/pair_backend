        <!-- P-BS-20 — Spring Boot 4.1.1 embarque Tomcat 11.0.24, encore touché par
             GHSA-9xv2-5v5q-p794 (CVSS 9,8) et deux failles à 9,1, corrigées en 11.0.25.
             À retirer dès qu'une version de Boot embarque 11.0.25 ou plus. -->
        <tomcat.version>11.0.25</tomcat.version>

        <!--
          Identité du build, gravée dans build-info.properties et rendue par
          /actuator/info. Valeur de repli pour une construction locale ; la
          plateforme de déploiement la remplace par le profil ci-dessous. Une seule
          propriété, et pas la branche : le profil s'active sur la présence du sha,
          et une variable de branche absente ferait échouer la construction sur un
          renseignement qui n'apprend rien de plus.
        -->
        <build.commit>local</build.commit>
    </properties>

    <profiles>
        <!--
          Sur la plateforme de déploiement, le sha et la branche viennent de
          l'environnement. Le profil ne s'active que si la variable existe : une
          construction locale garde ses valeurs de repli plutôt que d'échouer.
        -->
        <profile>
            <id>build-identity-from-env</id>
            <activation>
                <property>
                    <name>env.RAILWAY_GIT_COMMIT_SHA</name>
                </property>
            </activation>
            <properties>
                <build.commit>${env.RAILWAY_GIT_COMMIT_SHA}</build.commit>
            </properties>
        </profile>
    </profiles>
